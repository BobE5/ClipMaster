<Window x:Class="ClipMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ClipMaster"
        Height="600" Width="900"
        MinHeight="400" MinWidth="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="{StaticResource PrimaryDarkBrush}" 
            CornerRadius="8" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" 
                    Background="#111827" 
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <Border Width="24" Height="24"
                                CornerRadius="4" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3b82f6" Offset="0"/>
                                    <GradientStop Color="#8b5cf6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="📋" FontSize="12" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ClipMaster" 
                                   Foreground="White" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="v1.0" 
                                   Foreground="#6b7280" 
                                   FontSize="11"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Center">
                        <Button x:Name="SettingsButton" 
                                Content="⚙️" 
                                Width="36" Height="36"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#9ca3af"
                                FontSize="14"
                                Click="SettingsButton_Click"
                                Cursor="Hand"/>
                        <Button x:Name="MinimizeButton" 
                                Content="─" 
                                Width="36" Height="36"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#9ca3af"
                                FontSize="12"
                                Click="MinimizeButton_Click"
                                Cursor="Hand"/>
                        <Button x:Name="CloseButton" 
                                Content="✕" 
                                Width="36" Height="36"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#9ca3af"
                                FontSize="12"
                                Click="CloseButton_Click"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Shortcut Tips Bar -->
            <Border Grid.Row="1" Background="#1e3a5f" Padding="8,2">
                <TextBlock Foreground="#93c5fd" FontSize="11" HorizontalAlignment="Center">
                    <Run Text="💡 Shortcuts:"/>
                    <Run Text="Ctrl+Shift+V" FontWeight="SemiBold"/> <Run Text="Show/Hide"/>
                    <Run Text="  •  "/>
                    <Run Text="Ctrl+Shift+C" FontWeight="SemiBold"/> <Run Text="Quick Paste"/>
                    <Run Text="  •  "/>
                    <Run Text="Click tray icon or double-click to restore"/>
                </TextBlock>
            </Border>

            <!-- Toolbar -->
            <Border Grid.Row="2"
                    Background="{StaticResource SecondaryDarkBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="SoundCheckBox"
                                  Content="🔊 Sound"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  IsChecked="True"
                                  Checked="SoundCheckBox_Changed"
                                  Unchecked="SoundCheckBox_Changed"
                                  VerticalAlignment="Center"
                                  Margin="0,0,4,0"/>
                        <Button Content="♪" Click="ChangeSoundButton_Click"
                                Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderThickness="0" Padding="4,2" Cursor="Hand"
                                ToolTip="Change notification sound"
                                VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <CheckBox x:Name="AlwaysOnTopCheckBox"
                                  Content="📌 Always on Top"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  IsChecked="False"
                                  Checked="AlwaysOnTopCheckBox_Changed"
                                  Unchecked="AlwaysOnTopCheckBox_Changed"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#22c55e" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StatusText" 
                                   Text="Monitoring Active" 
                                   Foreground="#22c55e" 
                                   FontSize="12"
                                   Margin="0,0,20,0"/>
                        <TextBlock x:Name="ClipCountText" 
                                   Text="0 clips stored" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel - Clip History -->
                <Border Grid.Column="0" 
                        Background="#151a27"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Search Box -->
                        <Border Grid.Row="0" 
                                Padding="10"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBox x:Name="SearchTextBox" 
                                         Style="{StaticResource SearchTextBoxStyle}"
                                         TextChanged="SearchTextBox_TextChanged"/>
                                <TextBlock Text="🔍" 
                                           HorizontalAlignment="Right" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="Search clips..." 
                                           HorizontalAlignment="Left" 
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Foreground="#6b7280"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Text.Length, ElementName=SearchTextBox, 
                                               Converter={StaticResource BoolToVis}, 
                                               ConverterParameter=Inverse}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- Clip List -->
                        <ListBox x:Name="ClipListBox" 
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ClipListItemStyle}"
                                 SelectionChanged="ClipListBox_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding SourceApp}" 
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Text="{Binding TimeDisplay}" 
                                                       HorizontalAlignment="Right"
                                                       Foreground="#6b7280"
                                                       FontSize="11"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding Preview}" 
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- History Actions -->
                        <Border Grid.Row="2" 
                                Padding="10"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" 
                                        Content="Clear All" 
                                        Style="{StaticResource ToolButtonStyle}"
                                        Click="ClearAllButton_Click"
                                        Margin="0,0,4,0"/>
                                <Button Grid.Column="1" 
                                        Content="Export" 
                                        Style="{StaticResource ToolButtonStyle}"
                                        Click="ExportButton_Click"
                                        Margin="4,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Panel - Current Clip & Tools -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Transform Toolbar -->
                    <Border Grid.Row="0" 
                            Background="{StaticResource SecondaryDarkBrush}"
                            Padding="12,8"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="TEXT TRANSFORMATIONS" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10"
                                       Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button Content="A  UPPERCASE" Style="{StaticResource ToolButtonStyle}" Click="Transform_Uppercase"/>
                                <Button Content="a  lowercase" Style="{StaticResource ToolButtonStyle}" Click="Transform_Lowercase"/>
                                <Button Content="Aa Title Case" Style="{StaticResource ToolButtonStyle}" Click="Transform_TitleCase"/>
                                <Button Content="Aa Sentence" Style="{StaticResource ToolButtonStyle}" Click="Transform_SentenceCase"/>
                                <Button Content="¶  Remove EOL" Style="{StaticResource ToolButtonStyle}" Click="Transform_RemoveEOL"/>
                                <Button Content="⌫  Trim Spaces" Style="{StaticResource ToolButtonStyle}" Click="Transform_TrimSpaces"/>
                                <Button Content="↕  Sort Lines" Style="{StaticResource ToolButtonStyle}" Click="Transform_SortLines"/>
                                <Button Content="🔄 Reverse" Style="{StaticResource ToolButtonStyle}" Click="Transform_Reverse"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Additional Tools Row -->
                    <Border Grid.Row="1" 
                            Background="{StaticResource SecondaryDarkBrush}"
                            Padding="12,8"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <WrapPanel>
                            <Button Content="📝 Remove Formatting" Style="{StaticResource ToolButtonStyle}" Click="Transform_RemoveFormatting"/>
                            <Button Content="🔗 Extract URLs" Style="{StaticResource ToolButtonStyle}" Click="Extract_URLs"/>
                            <Button Content="📧 Extract Emails" Style="{StaticResource ToolButtonStyle}" Click="Extract_Emails"/>
                            <Button Content="🔢 Extract Numbers" Style="{StaticResource ToolButtonStyle}" Click="Extract_Numbers"/>
                            <Button Content="#️⃣ Line Numbers" Style="{StaticResource ToolButtonStyle}" Click="Transform_LineNumbers"/>
                            <Button Content="🗑️ Remove Duplicates" Style="{StaticResource ToolButtonStyle}" Click="Transform_RemoveDuplicates"/>
                            <Button Content="{}{} JSON Format" Style="{StaticResource ToolButtonStyle}" Click="Transform_JsonFormat"/>
                            <Button Content=".*  Regex" Style="{StaticResource ToolButtonStyle}" Click="OpenRegexWindow_Click" FontFamily="Consolas"/>
                        </WrapPanel>
                    </Border>

                    <!-- Text Area -->
                    <Border Grid.Row="2" Padding="12">
                        <TextBox x:Name="CurrentTextBox"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#111827"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="White"
                                 BorderThickness="0"
                                 Padding="12"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 TextChanged="CurrentTextBox_TextChanged"/>
                    </Border>

                    <!-- Bottom Action Bar -->
                    <Border Grid.Row="3" 
                            Background="{StaticResource SecondaryDarkBrush}"
                            Padding="12,8"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock x:Name="StatsText" 
                                       Text="0 chars | 0 words | 0 lines"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Right">
                                <Button Content="↩️ Undo" 
                                        Style="{StaticResource ToolButtonStyle}"
                                        Click="UndoButton_Click"/>
                                <Button Content="📋 Copy to Clipboard" 
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="CopyButton_Click"/>
                                <Button Content="📤 Paste &amp; Send" 
                                        Click="PasteAndSendButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#16a34a"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="4"
                    Background="#111827"
                    CornerRadius="0,0,8,8"
                    Padding="12,4">
                <Grid>
                    <TextBlock x:Name="LastClipText"
                               Text="Ready"
                               Foreground="#6b7280"
                               FontSize="11"/>
                    <TextBlock x:Name="StatusClipCountText"
                               Text="0 clips stored"
                               Foreground="#6b7280"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MemoryText"
                               Text="Memory: 0 MB"
                               Foreground="#6b7280"
                               FontSize="11"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Resize Grip -->
            <ResizeGrip Grid.Row="4" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Bottom"
                        Cursor="SizeNWSE"/>
        </Grid>
    </Border>
</Window>
