<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClipMaster</AssemblyName>
    <RootNamespace>ClipMaster</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>ClipMaster Team</Authors>
    <Description>A powerful clipboard manager for Windows 10/11</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\**\*" />
    <Content Include="Sounds\*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
