<Window x:Class="ClipMaster.RegexTransformWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Regex Transform"
        Height="650" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#1a1f2e"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Border Background="#1a1f2e" CornerRadius="8" BorderBrush="#4b5563" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#1f2937" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Regex Transform" Foreground="White" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0"/>
                    <Button Content="✕" HorizontalAlignment="Right"
                            Background="#ef4444" Foreground="White"
                            BorderThickness="0" Width="36" Height="36"
                            Click="CloseButton_Click" Cursor="Hand" FontWeight="Bold"/>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel - Pattern Library -->
                <Border Grid.Column="0" Background="#1f2937" CornerRadius="6" Margin="0,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Pattern Library" Foreground="#f3f4f6"
                                   FontWeight="SemiBold" Margin="12,12,12,8"/>

                        <ListBox x:Name="PatternListBox" Grid.Row="1"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#f3f4f6" Margin="8,0"
                                 SelectionChanged="PatternListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#f3f4f6"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="#9ca3af" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#3b82f6"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#374151"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,8">
                            <Button Content="+ New" Click="NewPatternButton_Click"
                                    Background="#3b82f6" Foreground="White" BorderThickness="0"
                                    Padding="12,6" Cursor="Hand"/>
                            <Button x:Name="DeletePatternButton" Content="Delete" Click="DeletePatternButton_Click"
                                    Background="#ef4444" Foreground="White" BorderThickness="0"
                                    Padding="12,6" Margin="4,0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Panel - Editor -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Pattern Editor -->
                    <Border Grid.Row="0" Background="#1f2937" CornerRadius="6" Padding="12" Margin="6,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Foreground="#9ca3af"
                                       VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox x:Name="PatternNameTextBox" Grid.Row="0" Grid.Column="1"
                                     Background="#374151" Foreground="#f3f4f6" BorderThickness="0"
                                     Padding="8,6" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Pattern:" Foreground="#9ca3af"
                                       VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox x:Name="PatternTextBox" Grid.Row="1" Grid.Column="1"
                                     Background="#374151" Foreground="#f3f4f6" BorderThickness="0"
                                     Padding="8,6" Margin="0,0,0,8" FontFamily="Consolas"
                                     TextChanged="PatternTextBox_TextChanged"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Replace:" Foreground="#9ca3af"
                                       VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox x:Name="ReplacementTextBox" Grid.Row="2" Grid.Column="1"
                                     Background="#374151" Foreground="#f3f4f6" BorderThickness="0"
                                     Padding="8,6" Margin="0,0,0,8" FontFamily="Consolas"
                                     TextChanged="ReplacementTextBox_TextChanged"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Description:" Foreground="#9ca3af"
                                       VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox x:Name="DescriptionTextBox" Grid.Row="3" Grid.Column="1"
                                     Background="#374151" Foreground="#f3f4f6" BorderThickness="0"
                                     Padding="8,6" Margin="0,0,0,8"/>

                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <CheckBox x:Name="GlobalCheckBox" Content="Global (all)"
                                          Foreground="#9ca3af" IsChecked="True" Margin="0,0,16,0"
                                          Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                                <CheckBox x:Name="CaseSensitiveCheckBox" Content="Case Sensitive"
                                          Foreground="#9ca3af" IsChecked="True" Margin="0,0,16,0"
                                          Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                                <CheckBox x:Name="MultilineCheckBox" Content="Multiline"
                                          Foreground="#9ca3af" IsChecked="False"
                                          Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Validation Status -->
                    <Border Grid.Row="1" Background="#1f2937" CornerRadius="6" Padding="8" Margin="6,0,0,6">
                        <TextBlock x:Name="ValidationTextBlock" Text="Enter a regex pattern"
                                   Foreground="#9ca3af" FontSize="12"/>
                    </Border>

                    <!-- Preview Panel -->
                    <Grid Grid.Row="2" Margin="6,0,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Input -->
                        <Border Grid.Row="0" Background="#1f2937" CornerRadius="6" Margin="0,0,0,3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Input Text:" Foreground="#9ca3af" Margin="12,8"/>
                                <TextBox x:Name="InputTextBox" Grid.Row="1"
                                         Background="#111827" Foreground="#f3f4f6" BorderThickness="0"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Padding="12"
                                         FontFamily="Consolas" FontSize="13"
                                         TextChanged="InputTextBox_TextChanged"/>
                            </Grid>
                        </Border>

                        <!-- Output -->
                        <Border Grid.Row="1" Background="#1f2937" CornerRadius="6" Margin="0,3,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="Output Preview:" Foreground="#9ca3af" Margin="12,8"/>
                                    <TextBlock x:Name="MatchCountTextBlock" Text="" Foreground="#22c55e"
                                               Margin="8,8" FontSize="12"/>
                                </StackPanel>
                                <TextBox x:Name="OutputTextBox" Grid.Row="1"
                                         Background="#111827" Foreground="#f3f4f6" BorderThickness="0"
                                         AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto" Padding="12"
                                         FontFamily="Consolas" FontSize="13"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Action Buttons -->
                    <Border Grid.Row="3" Background="#1f2937" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Click="CloseButton_Click"
                                    Background="#6b7280" Foreground="White" BorderThickness="0"
                                    Padding="16,8" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Content="Save Pattern" Click="SavePatternButton_Click"
                                    Background="#374151" Foreground="White" BorderThickness="0"
                                    Padding="16,8" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Content="Apply to Clipboard" Click="ApplyButton_Click"
                                    Background="#3b82f6" Foreground="White" BorderThickness="0"
                                    Padding="16,8" Cursor="Hand" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
